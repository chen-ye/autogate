{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@autogate/core": [
        "./packages/core/src/index.ts"
      ],
      "@autogate/core/*": [
        "./packages/core/src/*"
      ],
      "@autogate/opencode": [
        "./packages/opencode/src/index.ts"
      ],
      "@autogate/opencode/*": [
        "./packages/opencode/src/*"
      ]
    },
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["**/test/**", "node_modules"]
}
