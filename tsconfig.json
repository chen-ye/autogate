{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "paths": {
      "@autogate/core": [
        "./packages/core/src/index.ts"
      ],
      "@autogate/core/*": [
        "./packages/core/src/*"
      ],
      "@autogate/opencode": [
        "./packages/opencode/src/index.ts"
      ],
      "@autogate/opencode/*": [
        "./packages/opencode/src/*"
      ],
      "@autogate/opencode1": [
        "./packages/opencode1/src/index.ts"
      ],
      "@autogate/opencode1/*": [
        "./packages/opencode1/src/*"
      ]
    }
  },
  "exclude": [
    "**/test/**",
    "node_modules"
  ]
}
